-- Native GL.iNet RPC bridge for Wol-PC.
local M = {}

local function quote(value)
    return "'" .. tostring(value or ""):gsub("'", "'\\''") .. "'"
end

local function run(argv)
    local parts = {}
    for i, arg in ipairs(argv) do parts[i] = quote(arg) end
    local pipe = io.popen(table.concat(parts, " ") .. " 2>&1; printf '\\n__RC__%s' $?")
    if not pipe then return 127, "command unavailable" end
    local output = pipe:read("*a") or ""
    pipe:close()
    local body, code = output:match("^(.*)\n__RC__(%d+)$")
    return tonumber(code) or 1, body or output
end

local function valid_mac(value)
    return type(value) == "string"
        and value:match("^[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]:[%x][%x]$") ~= nil
end

local function clean_name(value)
    value = tostring(value or ""):gsub("[%z\r\n]", ""):match("^%s*(.-)%s*$") or ""
    if #value > 64 then value = value:sub(1, 64) end
    return value
end

local function uci_get(path, fallback)
    local rc, value = run({ "uci", "-q", "get", path })
    if rc ~= 0 then return fallback or "" end
    local cleaned = (value or ""):gsub("[\r\n]+$", "")
    return cleaned
end

local function u16(value)
    value = tonumber(value) or 0
    return string.char(math.floor(value / 256) % 256, value % 256)
end

local function read_u16(data, offset)
    local high, low = data:byte(offset, offset + 1)
    if not high or not low then return nil end
    return high * 256 + low
end

local function skip_dns_name(data, offset)
    while offset <= #data do
        local length = data:byte(offset)
        if not length then return nil end
        if length == 0 then return offset + 1 end
        if length >= 192 then return offset + 2 end
        offset = offset + length + 1
    end
end

-- Ask a Windows host for its workstation name without relying on DHCP or ping.
local function netbios_name(ip)
    if not tostring(ip or ""):match("^%d+%.%d+%.%d+%.%d+$") then return "" end
    local ok, socket = pcall(require, "socket")
    if not ok or not socket or type(socket.udp) ~= "function" then return "" end

    local wildcard = "*" .. string.rep(string.char(0), 15)
    local encoded = {}
    for index = 1, #wildcard do
        local byte = wildcard:byte(index)
        encoded[#encoded + 1] = string.char(65 + math.floor(byte / 16), 65 + byte % 16)
    end
    local query = u16(0x574F) .. u16(0) .. u16(1) .. u16(0) .. u16(0) .. u16(0)
        .. string.char(32) .. table.concat(encoded) .. string.char(0) .. u16(0x21) .. u16(1)
    local udp = socket.udp()
    if not udp then return "" end
    udp:settimeout(0.45)
    local sent = udp:sendto(query, ip, 137)
    if not sent then udp:close(); return "" end
    local response = udp:receivefrom()
    udp:close()
    if type(response) ~= "string" or #response < 20 then return "" end

    local offset = skip_dns_name(response, 13)
    if not offset then return "" end
    offset = offset + 4
    local answers = read_u16(response, 7) or 0
    for _ = 1, answers do
        offset = skip_dns_name(response, offset)
        if not offset or offset + 9 > #response then return "" end
        local answer_type = read_u16(response, offset)
        local data_length = read_u16(response, offset + 8) or 0
        local data_offset = offset + 10
        if answer_type == 0x21 and data_length >= 19 then
            local count = response:byte(data_offset) or 0
            for index = 0, count - 1 do
                local entry = data_offset + 1 + index * 18
                if entry + 17 > #response then break end
                local suffix = response:byte(entry + 15)
                local flags = read_u16(response, entry + 16) or 0
                if suffix == 0 and flags < 0x8000 then
                    return clean_name(response:sub(entry, entry + 14):gsub("%s+$", ""))
                end
            end
        end
        offset = data_offset + data_length
    end
    return ""
end

local function load_targets()
    local _, raw = run({ "sh", "-c", "uci -q show gl-wol-lan | sed -n \"s/^gl-wol-lan\\.\\([^.=]*\\)=target$/\\1/p\"" })
    local result = {}
    for section in tostring(raw or ""):gmatch("[^\r\n]+") do
        local mac = uci_get("gl-wol-lan." .. section .. ".mac")
        if valid_mac(mac) then
            result[#result + 1] = {
                id = section,
                name = uci_get("gl-wol-lan." .. section .. ".name", "PC"),
                mac = mac:upper(),
                ttl = tonumber(uci_get("gl-wol-lan." .. section .. ".ttl", "0")) or 0
            }
        end
    end
    return result
end

local function load_clients(interface)
    local by_mac, result = {}, {}
    local ignored_macs = {}
    local traffic_clients = {}
    local aggregate_speed = { speed_rx = 0, speed_tx = 0 }
    local json_ok, json = pcall(require, "cjson.safe")
    if json_ok and json then
        local rc, raw = run({ "ubus", "call", "gl-clients", "list", "{}" })
        if rc == 0 then
            local decoded = json.decode(raw or "")
            traffic_clients = decoded and decoded.clients or {}
        end
        local speed_rc, speed_raw = run({ "ubus", "call", "gl-clients", "get_speed", "{}" })
        if speed_rc == 0 then
            aggregate_speed = json.decode(speed_raw or "") or aggregate_speed
        end
    end
    for mac in uci_get("gl-wol-lan.main.ignore_mac", ""):gmatch("%S+") do
        ignored_macs[mac:upper()] = true
    end

    local leases = io.open("/tmp/dhcp.leases", "r")
    if leases then
        for line in leases:lines() do
            local _, mac, ip, name = line:match("^(%S+)%s+(%S+)%s+(%S+)%s+(%S+)")
            mac = tostring(mac or ""):upper()
            if valid_mac(mac) then
                local client = {
                    name = name ~= "*" and name or "",
                    mac = mac,
                    ip = ip or "",
                    online = false
                }
                by_mac[mac] = client
                result[#result + 1] = client
            end
        end
        leases:close()
    end

    local _, neighbors = run({ "ip", "neigh", "show", "dev", interface })
    for line in tostring(neighbors or ""):gmatch("[^\r\n]+") do
        local ip, mac = line:match("^(%S+).-[Ll][Ll][Aa][Dd][Dd][Rr]%s+(%S+)")
        mac = tostring(mac or ""):upper()
        if valid_mac(mac) then
            local client = by_mac[mac]
            if not client then
                client = { name = "", mac = mac, ip = ip or "", online = false }
                by_mac[mac] = client
                result[#result + 1] = client
            elseif client.ip == "" then
                client.ip = ip or ""
            end
            client.online = not line:match("%sFAILED%s*$") and not line:match("%sINCOMPLETE%s*$")
        end
    end

    local lan_ports = {}
    local _, stp = run({ "brctl", "showstp", interface })
    for line in tostring(stp or ""):gmatch("[^\r\n]+") do
        local device, port = line:match("^([%w_.:-]+)%s+%((%d+)%)")
        if device and device:match("^lan%d+$") and port then
            lan_ports[tonumber(port)] = device
        end
    end

    local wired_macs = {}
    local _, fdb = run({ "brctl", "showmacs", interface })
    for line in tostring(fdb or ""):gmatch("[^\r\n]+") do
        local port, mac, is_local = line:match("^%s*(%d+)%s+(%S+)%s+(%S+)")
        mac = tostring(mac or ""):upper()
        if lan_ports[tonumber(port)] and is_local == "no" and valid_mac(mac) then
            wired_macs[mac] = lan_ports[tonumber(port)]
        end
    end

    local wired = {}
    for _, client in ipairs(result) do
        local port = wired_macs[client.mac]
        if port and not ignored_macs[client.mac] then
            client.port = port
            local _, ping = run({ "ping", "-c", "1", "-W", "1", client.ip })
            client.ttl = tonumber(tostring(ping or ""):match("ttl[= ](%d+)")) or 0
            if client.name == "" and client.ttl == 0 then
                client.name = netbios_name(client.ip)
                if client.name ~= "" then client.ttl = 128 end
            end
            local traffic = traffic_clients[client.mac] or traffic_clients[client.mac:lower()] or {}
            client.download = tonumber(aggregate_speed.speed_tx) or tonumber(traffic.tx) or 0
            client.upload = tonumber(aggregate_speed.speed_rx) or tonumber(traffic.rx) or 0
            client.total_download = tonumber(traffic.total_tx) or 0
            client.total_upload = tonumber(traffic.total_rx) or 0
            if client.ttl ~= 64 or client.name ~= "" then wired[#wired + 1] = client end
        end
    end
    result = wired

    table.sort(result, function(a, b)
        if a.online ~= b.online then return a.online end
        return tostring(a.ip) < tostring(b.ip)
    end)
    return result
end

function M.list()
    local interface = uci_get("gl-wol-lan.main.interface", "br-lan")
    if not interface:match("^[%w_.:-]+$") then interface = "br-lan" end
    return {
        ok = true,
        interface = interface,
        broadcast = uci_get("gl-wol-lan.main.broadcast", "1"),
        targets = load_targets(),
        clients = load_clients(interface)
    }
end

function M.save(params)
    params = params or {}
    local name = clean_name(params.name)
    local mac = tostring(params.mac or ""):upper()
    if name == "" then return { ok = false, error = "name_required" } end
    if not valid_mac(mac) then return { ok = false, error = "invalid_mac" } end

    local section = tostring(params.id or "")
    if not section:match("^wol_%d+$") then
        section = "wol_" .. tostring(os.time())
        local suffix = 0
        while uci_get("gl-wol-lan." .. section, "") ~= "" do
            suffix = suffix + 1
            section = "wol_" .. tostring(os.time()) .. tostring(suffix)
        end
        run({ "uci", "set", "gl-wol-lan." .. section .. "=target" })
    end
    run({ "uci", "set", "gl-wol-lan." .. section .. ".name=" .. name })
    run({ "uci", "set", "gl-wol-lan." .. section .. ".mac=" .. mac })
    local rc, output = run({ "uci", "commit", "gl-wol-lan" })
    return { ok = rc == 0, id = section, rc = rc, output = output }
end

function M.remove(params)
    local section = tostring((params or {}).id or "")
    if not section:match("^wol_%d+$") then return { ok = false, error = "invalid_id" } end
    run({ "uci", "-q", "delete", "gl-wol-lan." .. section })
    local rc, output = run({ "uci", "commit", "gl-wol-lan" })
    return { ok = rc == 0, rc = rc, output = output }
end

function M.wake(params)
    local mac = tostring((params or {}).mac or ""):upper()
    if not valid_mac(mac) then return { ok = false, error = "invalid_mac" } end
    local interface = uci_get("gl-wol-lan.main.interface", "br-lan")
    if not interface:match("^[%w_.:-]+$") then interface = "br-lan" end
    local argv = { "/usr/libexec/gl-wol-lan/wol-send", "-i", interface }
    if uci_get("gl-wol-lan.main.broadcast", "1") == "1" then argv[#argv + 1] = "-b" end
    argv[#argv + 1] = mac
    local rc, output = run(argv)
    return { ok = rc == 0, rc = rc, output = output, mac = mac }
end

return M
